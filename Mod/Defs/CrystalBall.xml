<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- A crystal ball people come to look into for their future.

       WHY A NEW RECREATION TYPE. That is the scarce commodity, and the thread running through
       this whole mod: the base game offers only ten types - Meditative, Social, Gaming_Dexterity,
       Gaming_Cerebral, Television, Telescope, HighCulture, Chemical, Gluttonous, Reading - and
       only four of them come from a building. Expectations ask for up to six different ones, and
       tolerance is counted PER TYPE: ten chess tables tire a colonist exactly as fast as one. An
       eleventh type is therefore worth more than a tenth piece of furniture on a type already
       served.

       Divination did not have to be invented for the occasion either: a crystal ball carries its
       own use, which avoids the usual trap of a recreation type bolted on for the count and
       justified by nothing in play.

       NO CODE. `JoyGiver_InteractBuildingSitAdjacent` and `JobDriver_SitFacingBuilding` are the
       vanilla chess ones, and they work here as they are because a crystal ball is a `Building` -
       unlike the anima tree, a `Plant`, on which that same driver raised an InvalidCastException.
       So this mod ships no assembly at all.

       `requireChair` FALSE, as for the game of stones and the campfire storytelling: you crouch
       in front of a crystal ball, you do not pull a dining chair up to it. Without this, a
       fortune teller's caravan would never be used.

       THE GLOW IS A REAL LIGHT and it is permanent, unlike the firework stand's, which only comes
       on when firing. Here that is deliberate: an unlit crystal ball is just a paperweight, and a
       small radius of 3 makes it a landmark at night without replacing a lamp.

       JADE IS NOT A WHIM: it is the only translucent precious material in the base game, it is
       mined and traded, and its cost places the object - a luxury for an established colony, not
       a starting bench. -->

  <JoyKindDef>
    <defName>CB_Divination</defName>
    <label>divination</label>
  </JoyKindDef>

  <ThingDef ParentName="BuildingBase">
    <defName>CB_CrystalBall</defName>
    <label>crystal ball</label>
    <description>A polished sphere set on a clawed stand, glowing faintly violet from within. Whether anything is actually seen in it is beside the point: people sit down in front of it, look for a long while, and get up in a better mood than they sat down in.\n\nColonists gaze into it on their own, as recreation. No chair required.</description>
    <graphicData>
      <texPath>Things/Building/Joy/CrystalBall</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.15,1.15)</drawSize>
      <shadowData>
        <volume>(0.45,0.5,0.45)</volume>
        <offset>(0,0,-0.1)</offset>
      </shadowData>
      <damageData>
        <rect>(0.2,0.2,0.6,0.6)</rect>
      </damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>false</rotatable>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.35</fillPercent>
    <socialPropernessMatters>true</socialPropernessMatters>
    <!-- Minifiable AND filed under a thing category: the two go together. A def with
         `thingCategories` but no `minifiedDef` raises "is not minifiable yet has thing
         categories" at load time. -->
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsJoy</li>
    </thingCategories>
    <minTechLevelToBuild>Neolithic</minTechLevelToBuild>
    <building>
      <joyKind>CB_Divination</joyKind>
    </building>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>9000</WorkToBuild>
      <Mass>6</Mass>
      <Flammability>0.4</Flammability>
      <Beauty>10</Beauty>
      <JoyGainFactor>1</JoyGainFactor>
    </statBases>
    <costList>
      <Jade>40</Jade>
      <Gold>5</Gold>
    </costList>
    <comps>
      <!-- Quality scales beauty on its own, through the vanilla StatPart. It also gives the name
           its prefix: a masterwork crystal ball is worth talking about. -->
      <li>
        <compClass>CompQuality</compClass>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>3</glowRadius>
        <glowColor>(140,120,220,0)</glowColor>
      </li>
    </comps>
    <designationCategory>Joy</designationCategory>
    <designationHotKey>Misc3</designationHotKey>
  </ThingDef>

  <JobDef>
    <defName>CB_GazeIntoCrystalBall</defName>
    <driverClass>JobDriver_SitFacingBuilding</driverClass>
    <reportString>gazing into the crystal ball.</reportString>
    <joyDuration>4000</joyDuration>
    <!-- Two: you read someone's future, or you read your own. Not eight of you at once. -->
    <joyMaxParticipants>2</joyMaxParticipants>
    <joyKind>CB_Divination</joyKind>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

  <JoyGiverDef>
    <defName>CB_GazeIntoCrystalBall</defName>
    <giverClass>JoyGiver_InteractBuildingSitAdjacent</giverClass>
    <baseChance>2</baseChance>
    <requireChair>false</requireChair>
    <thingDefs>
      <li>CB_CrystalBall</li>
    </thingDefs>
    <jobDef>CB_GazeIntoCrystalBall</jobDef>
    <joyKind>CB_Divination</joyKind>
    <!-- Sight alone: it is all in the looking, the hands do nothing. -->
    <requiredCapacities>
      <li>Sight</li>
    </requiredCapacities>
  </JoyGiverDef>

</Defs>
